# Copy this file to .env or .env.local to override the connector defaults.
# The application loads .env and .env.local from the current directory.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY_ENV=LLM_API_KEY
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# Optional named Anthropic Messages connector.
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY_ENV=ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=

# Optional named Gemini GenerateContent connector.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY_ENV=GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
