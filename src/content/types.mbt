///|
/// Provider-independent message roles.
pub(all) enum Role {
  Developer
  System
  User
  Assistant
  Tool
} derive(Eq, Debug)

///|
/// Image detail hint retained in canonical history.
pub(all) enum ImageDetail {
  Auto
  Low
  High
} derive(Eq, Debug)

///|
/// A tool call generated by an assistant message.
pub(all) struct ToolCall {
  id : String
  name : String
  arguments_json : String
} derive(Eq, Debug)

///|
/// Canonical multimodal content. Attachment IDs are opaque service IDs.
pub(all) enum ContentPart {
  TextPart(String)
  ImageRef(String, ImageDetail)
  FileRef(String, String)
} derive(Eq, Debug)

///|
/// Message content is either legacy text or an ordered part list.
pub(all) enum MessageContent {
  Text(String)
  Parts(Array[ContentPart])
} derive(Eq, Debug)

///|
/// Canonical message stored in history and passed to hooks.
pub(all) struct Message {
  role : Role
  content : MessageContent?
  name : String?
  tool_call_id : String?
  reasoning_content : String?
  tool_calls : Array[ToolCall]
  refusal : String?
} derive(Eq, Debug)

///|
/// Build the compatibility representation used by the existing text runtime.
pub fn text_message(role : Role, text : String) -> Message {
  {
    role,
    content: Some(Text(text)),
    name: None,
    tool_call_id: None,
    reasoning_content: None,
    tool_calls: [],
    refusal: None,
  }
}
